#!/usr/bin/env bash
# Install the speaches STT container image (CPU variant).
# Requires: podman
set -euo pipefail
STT_DIR="${MOBUX_DATA_DIR:-$HOME/.local/share/mobux}/stt"
mkdir -p "$STT_DIR"
MOBUX_STT_IMAGE="${MOBUX_STT_IMAGE:-ghcr.io/speaches-ai/speaches:latest-cpu}"
echo "Pulling $MOBUX_STT_IMAGE ..."
podman pull "$MOBUX_STT_IMAGE"
echo "Done."
touch "$STT_DIR/.installed"
