#!/usr/bin/env bash
#
# bin/twa-build — build the signed TWA APK + matching assetlinks.json.
#
# Single implementation behind two callers: `make twa` (repo checkout) and the
# server's "Generate package" button, which materialises this script plus
# bin/setup-twa, twa/init.js and twa/twa-manifest.json.template into its data
# dir and runs them there. The toolchain bootstrap below sources the user-local
# installs so a systemd service with a bare PATH finds node, java and bubblewrap
# the same way an interactive shell does; when they are absent the server runs
# the setup script first and builds after it, so nobody has to open a terminal.
#
# `--check-toolchain` runs the bootstrap and the tool detection only, printing
# the missing tools and exiting non-zero when any are. That is what the server
# asks before every build, so the check and the build can never drift apart.
#
# The signing keystore lives at $MOBUX_CONFIG_DIR/twa-signing.keystore
# (default ~/.config/mobux). Lose the keystore and existing installs can no
# longer upgrade — only fresh-install. BACK IT UP.
#
# Env:
#   MOBUX_DOMAIN                   required, e.g. mine.example.com or host:5152
#   MOBUX_PACKAGE_ID               default io.github.mvhenten.mobux
#   MOBUX_APP_NAME                 default Mobux
#   TWA_WORK_DIR                   dir holding init.js + the manifest template
#   TWA_INSTALL_DIR                where mobux.apk is written
#   TWA_WELLKNOWN_DIR              where assetlinks.json is written
#   MOBUX_CONFIG_DIR               default ~/.config/mobux
#   MOBUX_TWA_KEYSTORE_PASSWORD    optional; else a generated password file
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

CHECK_TOOLCHAIN_ONLY=0
if [ "${1:-}" = "--check-toolchain" ]; then
  CHECK_TOOLCHAIN_ONLY=1
fi

MOBUX_PACKAGE_ID="${MOBUX_PACKAGE_ID:-io.github.mvhenten.mobux}"
MOBUX_APP_NAME="${MOBUX_APP_NAME:-Mobux}"
TWA_WORK_DIR="${TWA_WORK_DIR:-${SCRIPT_DIR}/../twa}"
TWA_INSTALL_DIR="${TWA_INSTALL_DIR:-${SCRIPT_DIR}/../web/static/install}"
TWA_WELLKNOWN_DIR="${TWA_WELLKNOWN_DIR:-${SCRIPT_DIR}/../web/static/.well-known}"
CONFIG_DIR="${MOBUX_CONFIG_DIR:-${HOME}/.config/mobux}"

if [ -z "${MOBUX_DOMAIN:-}" ] && [ "${CHECK_TOOLCHAIN_ONLY}" = "0" ]; then
  echo "MOBUX_DOMAIN is required, e.g. make twa MOBUX_DOMAIN=mine.example.com" >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# Toolchain. Additive only: anything already on PATH is left alone, so an
# interactive `make twa` behaves exactly as before.
# ---------------------------------------------------------------------------

SDKMAN_DIR="${SDKMAN_DIR:-${HOME}/.sdkman}"
NVM_DIR="${NVM_DIR:-${HOME}/.nvm}"
ANDROID_SDK_ROOT="${ANDROID_SDK_ROOT:-${HOME}/.android}"
NPM_PREFIX="${NPM_PREFIX:-${HOME}/.local}"

if ! command -v java >/dev/null 2>&1 && [ -s "${SDKMAN_DIR}/bin/sdkman-init.sh" ]; then
  set +u
  # shellcheck disable=SC1091
  . "${SDKMAN_DIR}/bin/sdkman-init.sh"
  set -u
fi

if ! command -v node >/dev/null 2>&1 && [ -s "${NVM_DIR}/nvm.sh" ]; then
  set +u
  # shellcheck disable=SC1091
  . "${NVM_DIR}/nvm.sh"
  nvm use --lts >/dev/null 2>&1 || true
  set -u
fi

export ANDROID_HOME="${ANDROID_HOME:-${ANDROID_SDK_ROOT}}"
export ANDROID_SDK_ROOT
export PATH="${NPM_PREFIX}/bin:${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${PATH}"

MISSING_TOOLS=()
for tool in node java keytool bubblewrap; do
  command -v "${tool}" >/dev/null 2>&1 || MISSING_TOOLS+=("${tool}")
done

if [ "${CHECK_TOOLCHAIN_ONLY}" = "1" ]; then
  if [ ${#MISSING_TOOLS[@]} -eq 0 ]; then
    exit 0
  fi
  printf '%s\n' "${MISSING_TOOLS[@]}"
  exit 1
fi

if [ ${#MISSING_TOOLS[@]} -ne 0 ]; then
  echo "The Android build toolchain is not installed (missing: ${MISSING_TOOLS[*]})." >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# Signing keystore
# ---------------------------------------------------------------------------

# Bounded input, and every stage reads it to the end: nothing here can be
# killed by SIGPIPE, which under `pipefail` aborts the script with a bare
# exit 141 on the fresh-keystore path — the first build on any host.
generate_keystore_password() {
  local password
  password="$(head -c 1024 /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | cut -c1-32)"
  if [ "${#password}" -ne 32 ]; then
    echo "Could not generate a 32-character keystore password." >&2
    return 1
  fi
  printf '%s' "${password}"
}

KEYSTORE="${CONFIG_DIR}/twa-signing.keystore"
PASSFILE="${CONFIG_DIR}/twa-signing.password"
mkdir -p "${CONFIG_DIR}"
chmod 700 "${CONFIG_DIR}" 2>/dev/null || true

FRESH_KEY=0
if [ ! -f "${KEYSTORE}" ]; then
  FRESH_KEY=1
  if [ -n "${MOBUX_TWA_KEYSTORE_PASSWORD:-}" ]; then
    KEYSTORE_PASSWORD="${MOBUX_TWA_KEYSTORE_PASSWORD}"
  else
    KEYSTORE_PASSWORD="$(generate_keystore_password)"
    (umask 077; printf '%s' "${KEYSTORE_PASSWORD}" > "${PASSFILE}")
    chmod 600 "${PASSFILE}"
  fi
  echo "Generating signing keystore at ${KEYSTORE}"
  keytool -genkeypair -v \
    -keystore "${KEYSTORE}" \
    -alias mobux \
    -keyalg RSA -keysize 2048 \
    -validity 10000 \
    -storepass "${KEYSTORE_PASSWORD}" \
    -keypass "${KEYSTORE_PASSWORD}" \
    -dname "CN=Mobux, OU=mobux, O=mobux, L=Unknown, ST=Unknown, C=XX" >/dev/null
  echo ""
  echo "============================================================"
  echo "  BACK THIS UP: ${KEYSTORE}"
  echo "  Losing this key prevents APK upgrades for existing installs."
  if [ -z "${MOBUX_TWA_KEYSTORE_PASSWORD:-}" ]; then
    echo "  Password written to: ${PASSFILE} (mode 0600)"
  fi
  echo "============================================================"
  echo ""
elif [ -n "${MOBUX_TWA_KEYSTORE_PASSWORD:-}" ]; then
  KEYSTORE_PASSWORD="${MOBUX_TWA_KEYSTORE_PASSWORD}"
elif [ -f "${PASSFILE}" ]; then
  KEYSTORE_PASSWORD="$(cat "${PASSFILE}")"
else
  echo "Keystore exists at ${KEYSTORE} but neither MOBUX_TWA_KEYSTORE_PASSWORD nor ${PASSFILE} is set." >&2
  exit 1
fi

CA_CERT="${CONFIG_DIR}/ca.crt"
if [ -f "${CA_CERT}" ] && [ -z "${NODE_EXTRA_CA_CERTS:-}" ]; then
  export NODE_EXTRA_CA_CERTS="${CA_CERT}"
fi

mkdir -p "${HOME}/.bubblewrap"
if [ ! -f "${HOME}/.bubblewrap/config.json" ]; then
  printf '{\n  "jdkPath": "%s",\n  "androidSdkPath": "%s"\n}\n' \
    "${JAVA_HOME:-${HOME}/.sdkman/candidates/java/current}" \
    "${ANDROID_HOME}" \
    > "${HOME}/.bubblewrap/config.json"
fi

# ---------------------------------------------------------------------------
# Render the manifest and generate the project
# ---------------------------------------------------------------------------

TEMPLATE="${TWA_WORK_DIR}/twa-manifest.json.template"
if [ ! -f "${TEMPLATE}" ]; then
  echo "Missing manifest template at ${TEMPLATE}." >&2
  exit 1
fi

echo "Rendering twa-manifest.json (MOBUX_DOMAIN=${MOBUX_DOMAIN}, packageId=${MOBUX_PACKAGE_ID}, name=${MOBUX_APP_NAME})"
sed -e "s|__MOBUX_DOMAIN__|${MOBUX_DOMAIN}|g" \
  -e "s|__MOBUX_KEYSTORE_PATH__|${KEYSTORE}|g" \
  -e "s|__MOBUX_PACKAGE_ID__|${MOBUX_PACKAGE_ID}|g" \
  -e "s|__MOBUX_APP_NAME__|${MOBUX_APP_NAME}|g" \
  "${TEMPLATE}" > "${TWA_WORK_DIR}/twa-manifest.json"

if [ -d "${TWA_WORK_DIR}/app" ]; then
  echo "Regenerating TWA project from manifest (${TWA_WORK_DIR}/app)"
  rm -rf "${TWA_WORK_DIR}/app"
fi
echo "Initializing TWA project (${TWA_WORK_DIR}/app)"
node "${TWA_WORK_DIR}/init.js"

echo "Building signed APK"
(
  cd "${TWA_WORK_DIR}/app"
  BUBBLEWRAP_KEYSTORE_PASSWORD="${KEYSTORE_PASSWORD}" \
    BUBBLEWRAP_KEY_PASSWORD="${KEYSTORE_PASSWORD}" \
    bubblewrap build
)

APK_SRC="${TWA_WORK_DIR}/app/app-release-signed.apk"
if [ ! -f "${APK_SRC}" ]; then
  echo "Expected signed APK at ${APK_SRC} but it is missing." >&2
  exit 1
fi

mkdir -p "${TWA_INSTALL_DIR}"
cp "${APK_SRC}" "${TWA_INSTALL_DIR}/mobux.apk"
echo "Wrote ${TWA_INSTALL_DIR}/mobux.apk"

FINGERPRINT="$(keytool -list -v \
  -keystore "${KEYSTORE}" \
  -alias mobux \
  -storepass "${KEYSTORE_PASSWORD}" 2>/dev/null \
  | awk '/SHA256:/ && !seen { print $2; seen = 1 }')"
if [ -z "${FINGERPRINT}" ]; then
  echo "Could not extract SHA-256 fingerprint from keystore." >&2
  exit 1
fi

mkdir -p "${TWA_WELLKNOWN_DIR}"
printf '[{\n  "relation": ["delegate_permission/common.handle_all_urls"],\n  "target": {\n    "namespace": "android_app",\n    "package_name": "%s",\n    "sha256_cert_fingerprints": ["%s"]\n  }\n}]\n' \
  "${MOBUX_PACKAGE_ID}" "${FINGERPRINT}" > "${TWA_WELLKNOWN_DIR}/assetlinks.json"
echo "Wrote ${TWA_WELLKNOWN_DIR}/assetlinks.json (fingerprint ${FINGERPRINT})"

if [ "${FRESH_KEY}" = "1" ]; then
  echo ""
  echo "Reminder: back up ${KEYSTORE} and ${PASSFILE} before you forget."
fi
