{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "types": [],
    "skipLibCheck": true,
    "lib": ["es2022", "dom"],
    "resolveJsonModule": false
  },
  "include": [
    "web/static/terminal-core.js",
    "web/static/terminal.js",
    "web/static/reader-view.js"
  ]
}
